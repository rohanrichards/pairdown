{
  "name": "pairdown",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Multiplayer markdown rooms with agents in them",
  "scripts": {
    "serve": "bun run src/server.ts",
    "mcp": "bun run src/mcp.ts",
    "build": "bun build client/editor.js --outdir public/js --splitting --format esm --target browser",
    "build:agent": "bun build src/mcp.ts --target bun --outfile dist/mcp.js",
    "build:all": "bun run build && bun run build:agent"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.7.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.13",
    "mermaid": "^11.16.1",
    "y-codemirror.next": "^0.3.6",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32"
  }
}
