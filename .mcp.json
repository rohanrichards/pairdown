{
  "mcpServers": {
    "pairdown": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/dist/mcp.js"
      ],
      "env": {
        "PAIRDOWN_PLUGIN_AGENT": "${user_config.agent_handle}",
        "PAIRDOWN_PLUGIN_OWNER": "${user_config.owner}",
        "PAIRDOWN_PLUGIN_URL": "${user_config.server_url}",
        "PAIRDOWN_PLUGIN_SECRET": "${user_config.shared_key}"
      }
    }
  }
}
